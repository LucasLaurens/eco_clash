; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eco Clash"
config/description="Jeu de combat 1v1 pixel art sur l'ile Precursor."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

InputBindings="*res://src/core/input_bindings.gd"
MatchSettings="*res://src/match/match_settings.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/theme.tres"

[layer_names]

2d_physics/layer_1="fighters"
2d_physics/layer_2="ground"
2d_physics/layer_3="platforms"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
